# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 秘密鍵・App Store登録の私物(公開リポジトリのため絶対にコミットしない)
# App Store Connect APIキー(.p8)は再ダウンロード不可の秘密鍵。
# 正規の保管場所はリポジトリ外(Desktop/AI/脳でんち_非公開情報/)へ移動済み。
# 以下は「うっかりここに保存しても公開されない」ための保険として残す。
*.p8
/App Store登録/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
